{
  "name": "stablebear-cuda",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "..",
    "args": {
      "BASE_IMAGE": "nvidia/cuda:12.6.3-devel-ubuntu22.04"
    }
  },

  // GPU passthrough. Requires nvidia-container-toolkit on the host (present).
  "runArgs": [
    "--gpus", "all",
    // Cap memory so a heavy parallel build OOM-kills inside the container
    // instead of taking down the host. Swap equal to memory disables swap.
    "--memory=24g", "--memory-swap=24g"
  ],
  "hostRequirements": {
    "gpu": true
  },

  "containerEnv": {
    "NVIDIA_VISIBLE_DEVICES": "all",
    "NVIDIA_DRIVER_CAPABILITIES": "compute,utility",
    // gh token passthrough for hosts that keep it in the OS keyring rather
    // than hosts.yml (where copying the config alone would not carry it).
    // Empty when unset on the host; gh treats that as absent.
    "GH_TOKEN": "${localEnv:GH_TOKEN}"
  },

  // Stage gh config for the image build and Claude/Codex state for the mounts
  // below, as the host user. Sources on AFS are copied, since Docker cannot
  // read them; other sources are symlinked so the mounts stay live.
  "initializeCommand": ["bash", "${localWorkspaceFolder}/.devcontainer/initialize.sh", "${localWorkspaceFolder}/.devcontainer/.local"],

  "remoteUser": "ubuntu",

  "mounts": [
    // Persist Claude Code auth/config across rebuilds.
    "source=${localWorkspaceFolder}/.devcontainer/.local/home/claude,target=/home/ubuntu/.claude,type=bind,consistency=cached",
    "source=${localWorkspaceFolder}/.devcontainer/.local/home/claude.json,target=/home/ubuntu/.claude.json,type=bind,consistency=cached",
    // Reuse the host's file-based Codex login while keeping container config/rules.
    "source=${localWorkspaceFolder}/.devcontainer/.local/home/codex-auth.json,target=/home/ubuntu/.codex/auth.json,type=bind,consistency=cached",
    // Container-private build dir. The workspace is bind-mounted from the host,
    // whose cmake-build-debug holds a CMakeCache.txt baked with host paths; this
    // volume shadows it so the container keeps its own cache (CMake refuses a
    // cache generated under a different source/binary path).
    "source=stablebear-cuda-build,target=${containerWorkspaceFolder}/cmake-build-debug,type=volume"
  ],

  // One-time, idempotent environment setup only: give the ubuntu user ownership
  // of the freshly-created (root-owned) build volume, then init submodules.
  // Python deps are already installed at image-build time (see Dockerfile).
  // Building the extensions is intentionally NOT done here: the build is the slow,
  // fragile part and is re-run constantly during development. Keeping it out of
  // postCreate also avoids wedging container creation when the persistent
  // cmake-build-debug volume holds a cache from a different generator/toolchain
  // (e.g. an old Unix Makefiles cache vs. the Ninja preset). Build manually with
  // the commands documented in AGENTS.md (which defines JOBS):
  //   cmake --preset debug && cmake --build --preset debug -j$JOBS && cmake --install cmake-build-debug
  // Claude Code is installed natively into ~/.local/bin by the Dockerfile, which
  // already matches installMethod=native in the bind-mounted ~/.claude.json, so
  // no /doctor-quieting symlink is needed here anymore.
  "postCreateCommand": "sudo chown ubuntu:ubuntu cmake-build-debug && git submodule update --init --recursive",

  // Rebuilding the container discards installed extensions, so reinstall the
  // Stablebear panel from .devcontainer/vscode-buttons on each attach.
  "postAttachCommand": "bash .devcontainer/vscode-buttons/install.sh",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools",
        "llvm-vs-code-extensions.vscode-clangd",
        "anthropic.claude-code",
        "openai.chatgpt"
      ],
      "settings": {
        // Python deps live in a venv outside the workspace folder (see
        // Dockerfile: VIRTUAL_ENV=/opt/venv). The Python extension only
        // auto-discovers .venv/venv *inside* the workspace, so without this it
        // falls back to the bare system python3 and flags numpy, pytest, etc.
        // as unresolved. Pin the interpreter so a rebuild needs no manual fix.
        "python.defaultInterpreterPath": "/opt/venv/bin/python",
        // The venv is already first on PATH (Dockerfile: ENV PATH=$VIRTUAL_ENV/bin:$PATH),
        // so terminal activation is redundant. Worse, the extension injects
        // `source /opt/venv/bin/activate` into each new terminal a beat after it
        // opens -- if Claude Code (a TUI) already owns that terminal, the text
        // lands in Claude's input prompt instead of the shell. Disable it.
        "python.terminal.activateEnvironment": false,
        // Tests must run from test/ so the source-tree stablebear/ dir doesn't
        // shadow the installed/built extension (see AGENTS.md > Testing).
        "python.testing.pytestEnabled": true,
        "python.testing.cwd": "${workspaceFolder}/test",
        "python.testing.pytestArgs": ["python"]
      }
    }
  }
}
