{
  "name": "stablebear-buttons",
  "displayName": "Stablebear buttons",
  "description": "A Stablebear panel with actions for common development commands and the progress of a plan.",
  "publisher": "stablebear",
  "version": "0.0.12",
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./extension.js",
  "files": [
    "extension.js",
    "plan.js",
    "logo.svg"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "stablebear.openPanel",
        "title": "Stablebear",
        "icon": "logo.svg"
      },
      {
        "command": "stablebear.buildDocs",
        "title": "Stablebear: Build docs"
      },
      {
        "command": "stablebear.openDocs",
        "title": "Stablebear: Open docs"
      },
      {
        "command": "stablebear.selectPlan",
        "title": "Stablebear: Select plan",
        "icon": "$(list-selection)"
      }
    ],
    "taskDefinitions": [
      {
        "type": "stablebear",
        "properties": {}
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "stablebear.openPanel",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "stablebear.selectPlan",
          "when": "view == stablebear.plan",
          "group": "navigation"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "stablebear",
          "title": "Stablebear",
          "icon": "logo.svg"
        }
      ]
    },
    "views": {
      "stablebear": [
        {
          "id": "stablebear.actions",
          "name": "Actions",
          "type": "webview"
        },
        {
          "id": "stablebear.plan",
          "name": "Plan"
        }
      ]
    }
  }
}
