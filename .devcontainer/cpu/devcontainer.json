{
  "name": "stablebear-cpu",

  // Reuses the shared Dockerfile with a plain Ubuntu base (no CUDA). Works on
  // any host -- including macOS (Apple Silicon arm64 or Intel) -- since there's
  // no GPU passthrough and the base image is multi-arch. With no nvcc present,
  // the build auto-disables CUDA; BUILD_WITH_CUDA=0 makes that explicit.
  "build": {
    "dockerfile": "../Dockerfile",
    "context": "../..",
    "args": {
      "BASE_IMAGE": "ubuntu:22.04"
    }
  },

  // Cap memory so a heavy parallel build OOM-kills inside the container
  // instead of taking down the host. Swap equal to memory disables swap.
  "runArgs": ["--memory=24g", "--memory-swap=24g"],

  "containerEnv": {
    "BUILD_WITH_CUDA": "0",
    // gh token passthrough for hosts that keep it in the OS keyring rather
    // than hosts.yml (where copying the config alone would not carry it).
    // Empty when unset on the host; gh treats that as absent.
    "GH_TOKEN": "${localEnv:GH_TOKEN}"
  },

  // Stage gh config for the image build and Claude/Codex state for the mounts
  // below, as the host user. Sources on AFS are copied, since Docker cannot
  // read them; other sources are symlinked so the mounts stay live.
  "initializeCommand": ["bash", "${localWorkspaceFolder}/.devcontainer/initialize.sh", "${localWorkspaceFolder}/.devcontainer/.local"],

  "remoteUser": "ubuntu",

  "mounts": [
    // Persist Claude Code auth/config across rebuilds.
    "source=${localWorkspaceFolder}/.devcontainer/.local/home/claude,target=/home/ubuntu/.claude,type=bind,consistency=cached",
    "source=${localWorkspaceFolder}/.devcontainer/.local/home/claude.json,target=/home/ubuntu/.claude.json,type=bind,consistency=cached",
    // Reuse the host's file-based Codex login while keeping container config/rules.
    "source=${localWorkspaceFolder}/.devcontainer/.local/home/codex-auth.json,target=/home/ubuntu/.codex/auth.json,type=bind,consistency=cached",
    // Container-private build dir (shadows the host's host-path CMakeCache.txt).
    "source=stablebear-cpu-build,target=${containerWorkspaceFolder}/cmake-build-debug,type=volume"
  ],

  // One-time environment setup only: give the ubuntu user ownership of the
  // freshly-created (root-owned) build volume, then init submodules. Python deps
  // are already installed at image-build time (see Dockerfile). Building the
  // extensions is intentionally NOT done here; build manually with the commands
  // in AGENTS.md (which defines JOBS):
  //   cmake --preset debug-nocuda && cmake --build --preset debug-nocuda -j$JOBS && cmake --install cmake-build-debug
  "postCreateCommand": "sudo chown ubuntu:ubuntu cmake-build-debug && git submodule update --init --recursive",

  // Rebuilding the container discards installed extensions, so reinstall the
  // Stablebear panel from .devcontainer/vscode-buttons on each attach.
  "postAttachCommand": "bash .devcontainer/vscode-buttons/install.sh",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools",
        "llvm-vs-code-extensions.vscode-clangd",
        "anthropic.claude-code",
        "openai.chatgpt"
      ],
      "settings": {
        // CMake Tools configures the project when the folder opens; configure
        // and build manually instead (see postCreateCommand above).
        "cmake.configureOnOpen": false
      }
    }
  }
}
